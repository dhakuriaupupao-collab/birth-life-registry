# Browser-safe Supabase configuration. These values are public project settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side Supabase configuration. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Privileged database connection used only when running Drizzle migrations.
LOVABLE_DB_MIGRATION_URL=
